# ---------------------------------------------------------------------
# STRATA secrets file -- TEMPLATE. This copy is safe to share because it
# holds no real keys.
#
# 1. Make your own copy named .env:
#       macOS/Linux:  cp .env.example .env
#       Windows:      copy .env.example .env
# 2. Paste your Alpaca PAPER keys into .env (not into this file).
# 3. Never share .env and never commit it. .gitignore already excludes it.
#
# Where to get paper keys: log in at https://app.alpaca.markets, switch
# to your Paper Trading account, and generate an API key on its home page.
# Alpaca shows the secret key only once, so paste it straight into .env.
# ---------------------------------------------------------------------

# Paper-trading keys (fake money). Used by backtest mode, paper mode
# and check_setup.py.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Live-trading keys (REAL money). Leave these EMPTY until you have
# finished every item on the go-live checklist in README.md.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Live-trading master switch. Live mode is refused unless this is
# exactly "true". Keep it false. Even when it is true, live mode ALSO
# needs the --live command-line flag and a confirmation phrase that you
# type by hand.
LIVE_TRADING=false

# Database password. docker compose gives it to the PostgreSQL container,
# and STRATA uses it to log in. Make up a long random one, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Token that protects the API's operator endpoints (at least 32
# characters). While it is empty, those endpoints refuse every request.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Where the dashboard listens (docker compose reads this; STRATA doesn't).
# 127.0.0.1 means this computer only. To open the dashboard from other
# devices on your home network, put this computer's home-network address
# here, for example 192.168.1.50 (see docs/DEPLOYMENT.md first).
STRATA_DASHBOARD_BIND=127.0.0.1
